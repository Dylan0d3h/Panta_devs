# Configuração da versão que vai para o FTP (usada pelo "npm run build:ftp").

# Deixe VAZIO para o site funcionar SEM servidor (só FTP). Nesse modo:
#   - clima, qualidade do ar e localização vêm direto do Open-Meteo e do OpenStreetMap;
#   - queimadas vêm direto do INPE (ou do arquivo gerado pelo script, se o INPE bloquear);
#   - saúde vem dos arquivos gerados pelo script emograma_api/gerar_dados_estaticos.py.
# Só preencha se um dia publicar a API em Python num servidor (ex: https://hemograma-api.onrender.com).
VITE_HEMOGRAMA_API=

# Pasta do site dentro da hospedagem:
#   "/"           -> site na raiz do domínio (ex: www.seusite.com.br)
#   "/pantanal/"  -> site numa subpasta (ex: www.seusite.com.br/pantanal)
SITE_BASE=/
