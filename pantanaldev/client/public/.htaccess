# Configuração para hospedagens Apache (a maioria das que usam FTP).
# Fica junto do index.html, na pasta onde o site foi enviado.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Endereços como /hemograma ou /equipe não existem como arquivos: o servidor
  # entrega o index.html e o React mostra a página certa.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Compacta os arquivos de texto (o site carrega mais rápido)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Os arquivos da pasta assets têm o "carimbo" da versão no nome: podem ficar
# guardados no navegador por bastante tempo. O index.html nunca fica guardado,
# para que uma versão nova apareça assim que for enviada.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Dados do Hemograma (pasta dados/): sempre confere se há versão nova
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
