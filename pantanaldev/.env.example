# Copie para ".env.production" (versão do FTP) ou ".env.development" (npm run dev).

# Vazio = site SEM servidor: o navegador busca os dados direto das fontes públicas e
# a saúde vem dos arquivos gerados por emograma_api/gerar_dados_estaticos.py.
# Para usar a API em Python: "/api" no npm run dev (com a API rodando no seu computador),
# ou o endereço da API publicada (ex: https://hemograma-api.onrender.com, sem barra no final).
VITE_HEMOGRAMA_API=

# Pasta do site dentro da hospedagem. Use "/" se o site fica na raiz do domínio
# (ex: www.seusite.com.br). Se fica numa subpasta (ex: www.ifms.edu.br/pantanal),
# use "/pantanal/" (com barra no começo e no fim).
SITE_BASE=/
